{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: Build practice (C++17)",
      "type": "process",
      "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": ["-std=c++17", "-O2", "-Wall", "-Wextra", "${file}", "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"],
      "options": {"cwd": "${fileDirname}", "env": {"PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"}},
      "problemMatcher": ["$gcc"],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "C++: Build debug (C++17)",
      "type": "process",
      "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": ["-std=c++17", "-g", "-O0", "-Wall", "-Wextra", "${file}", "-o", "${fileDirname}\\${fileBasenameNoExtension}.debug.exe"],
      "options": {"cwd": "${fileDirname}", "env": {"PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"}},
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "C++: Build practice (C++20)",
      "type": "process",
      "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": ["-std=c++20", "-O2", "-Wall", "-Wextra", "${file}", "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"],
      "options": {"cwd": "${fileDirname}", "env": {"PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"}},
      "problemMatcher": ["$gcc"],
      "group": "build"
    }
  ]
}
